{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assetxchain-exp2-phase4-run-preflight-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id","schema_version","tooling_version","run_id","status","created_at","timezone","validity_level","experiment_family","claim_boundary","baseline","inputs","protocol","fixture","tools","execution","environment","paths","prerequisites","planned_execution","capture_at_run"],
  "$defs": {
    "sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "git_sha": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "nonempty": {"type":"string","minLength":1},
    "path_hash": {"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"$ref":"#/$defs/nonempty"},"sha256":{"$ref":"#/$defs/sha256"}}}
  },
  "properties": {
    "schema_id": {"const":"assetxchain-exp2-phase4-run-preflight"},
    "schema_version": {"const":1},
    "tooling_version": {"const":"phase4-formal-tooling-v1"},
    "run_id": {"type":"string","pattern":"^p4-(e0|e1|e2|e3|e4|e5|e6)-(?:b1|b2|g3)-[0-9]{8}T[0-9]{6}\\+0800-[0-9a-f]{8}-[0-9a-f]{8}$"},
    "status": {"const":"planned"},
    "created_at": {"$ref":"#/$defs/nonempty"},
    "timezone": {"const":"Asia/Shanghai"},
    "validity_level": {"const":"provisional-candidate"},
    "experiment_family": {"enum":["E0","E1","E2","E3","E4","E5","E6"]},
    "claim_boundary": {"$ref":"#/$defs/nonempty"},
    "baseline": {
      "type":"object","additionalProperties":false,
      "required":["baseline_id","baseline_name","baseline_profile_version","worktree","branch","head","tree","parent","dirty","formal_base_commit","formal_base_is_ancestor"],
      "properties": {
        "baseline_id":{"enum":["B1","B2","G3"]},"baseline_name":{"enum":["Contract-only","Runtime-only","AssetXChain-CRS"]},"baseline_profile_version":{"const":"1"},
        "worktree":{"$ref":"#/$defs/nonempty"},"branch":{"$ref":"#/$defs/nonempty"},"head":{"$ref":"#/$defs/git_sha"},"tree":{"$ref":"#/$defs/git_sha"},"parent":{"$ref":"#/$defs/git_sha"},
        "dirty":{"const":false},"formal_base_commit":{"$ref":"#/$defs/git_sha"},"formal_base_is_ancestor":{"const":true}
      }
    },
    "inputs": {
      "type":"object","additionalProperties":false,
      "required":["environment_config","workload","scenario_catalog","baseline_manifest","workload_id","workload_class","seed","repetitions","selected_scenario_ids","required_invariants","deferred_invariants"],
      "properties": {
        "environment_config":{"$ref":"#/$defs/path_hash"},"workload":{"$ref":"#/$defs/path_hash"},"scenario_catalog":{"$ref":"#/$defs/path_hash"},"baseline_manifest":{"$ref":"#/$defs/path_hash"},
        "workload_id":{"$ref":"#/$defs/nonempty"},"workload_class":{"$ref":"#/$defs/nonempty"},"seed":{"type":"integer","minimum":0},"repetitions":{"type":"integer","minimum":1},
        "selected_scenario_ids":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/nonempty"}},"required_invariants":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/nonempty"}},"deferred_invariants":{"type":"array","items":{"$ref":"#/$defs/nonempty"}}
      }
    },
    "protocol": {
      "type":"object","additionalProperties":false,
      "required":["protocol_id","protocol_label","settlement_protocol_version","settlement_domain_id","encoding","hash_scheme_id","signature_scheme_id"],
      "properties": {"protocol_id":{"const":"assetxchain-paper2-shared"},"protocol_label":{"const":"assetxchain-paper2-shared-v1"},"settlement_protocol_version":{"const":1},"settlement_domain_id":{"const":"axc/p2/shared"},"encoding":{"const":"SCALE"},"hash_scheme_id":{"const":"blake2-256"},"signature_scheme_id":{"const":"sr25519-substrate-v1"}}
    },
    "fixture": {
      "type":"object","additionalProperties":false,
      "required":["fixture_profile_id","fixture_config_sha256","vector_bundle_id","vector_bundle","vector_bundle_sha256","role_account_ids","quantity","prices_plancks","market_fee_bps","safety_fee_bps","timing","capacity","funding_policy"],
      "properties": {
        "fixture_profile_id":{"const":"assetxchain-paper2-shared-fixture-v1"},"fixture_config_sha256":{"$ref":"#/$defs/sha256"},"vector_bundle_id":{"const":"assetxchain-paper2-shared-vectors-v1"},"vector_bundle":{"$ref":"#/$defs/nonempty"},"vector_bundle_sha256":{"$ref":"#/$defs/sha256"},
        "role_account_ids":{"type":"object"},"quantity":{"type":"integer","minimum":1},"prices_plancks":{"type":"object"},"market_fee_bps":{"type":"integer","minimum":0},"safety_fee_bps":{"type":"integer","minimum":0},"timing":{"type":"object"},"capacity":{"type":"object"},"funding_policy":{"type":"object"}
      }
    },
    "tools": {"type":"array","minItems":6,"items":{"type":"object","additionalProperties":false,"required":["tool_id","path","version","sha256"],"properties":{"tool_id":{"$ref":"#/$defs/nonempty"},"path":{"$ref":"#/$defs/nonempty"},"version":{"$ref":"#/$defs/nonempty"},"sha256":{"$ref":"#/$defs/sha256"}}}},
    "execution": {
      "type":"object","additionalProperties":false,
      "required":["executor_command","executor_artifacts","node_command","node_cwd","chain_mode","rpc_endpoint","ports","readiness_timeout_seconds","reset_policy","teardown_policy","build_commands","artifact_paths","artifact_hashes"],
      "properties": {
        "executor_command":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/nonempty"}},"executor_artifacts":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/path_hash"}},"node_command":{"type":"array","minItems":2,"items":{"$ref":"#/$defs/nonempty"}},"node_cwd":{"$ref":"#/$defs/nonempty"},"chain_mode":{"const":"dev-tmp"},"rpc_endpoint":{"const":"ws://127.0.0.1:9944"},
        "ports":{"type":"array","minItems":3,"items":{"type":"integer","minimum":1}},"readiness_timeout_seconds":{"type":"integer","minimum":1},"reset_policy":{"const":"fresh-owned-node-before-each-live-scenario-repetition"},"teardown_policy":{"const":"terminate-owned-process-and-require-9944-30333-9615-closed"},
        "build_commands":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/nonempty"}},"artifact_paths":{"type":"array","items":{"$ref":"#/$defs/nonempty"}},"artifact_hashes":{"type":"array","items":{"$ref":"#/$defs/path_hash"}}
      }
    },
    "environment": {
      "type":"object","additionalProperties":false,
      "required":["os","kernel","wsl_version","cpu_logical","memory_total_bytes","disk_available_bytes","rustc","cargo","python","protoc","nodejs","npm"],
      "properties": {"os":{"$ref":"#/$defs/nonempty"},"kernel":{"$ref":"#/$defs/nonempty"},"wsl_version":{"$ref":"#/$defs/nonempty"},"cpu_logical":{"type":"integer","minimum":1},"memory_total_bytes":{"type":"integer","minimum":1},"disk_available_bytes":{"type":"integer","minimum":1},"rustc":{"$ref":"#/$defs/nonempty"},"cargo":{"$ref":"#/$defs/nonempty"},"python":{"$ref":"#/$defs/nonempty"},"protoc":{"$ref":"#/$defs/nonempty"},"nodejs":{"$ref":"#/$defs/nonempty"},"npm":{"$ref":"#/$defs/nonempty"}}
    },
    "paths": {
      "type":"object","additionalProperties":false,
      "required":["raw","log","processed","report"],
      "properties":{"raw":{"$ref":"#/$defs/nonempty"},"log":{"$ref":"#/$defs/nonempty"},"processed":{"$ref":"#/$defs/nonempty"},"report":{"$ref":"#/$defs/nonempty"}}
    },
    "prerequisites": {
      "type":"object","additionalProperties":false,
      "required":["phase3_gate","ready_for_phase4","upstream_run_ids","approved_s4_8_candidate_id"],
      "properties":{"phase3_gate":{"const":"PASS"},"ready_for_phase4":{"const":true},"upstream_run_ids":{"type":"array","items":{"$ref":"#/$defs/nonempty"}},"approved_s4_8_candidate_id":{"type":["string","null"]}}
    },
    "planned_execution": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["sequence","scenario_id","repetition","execution_mode","order_key"],"properties":{"sequence":{"type":"integer","minimum":1},"scenario_id":{"$ref":"#/$defs/nonempty"},"repetition":{"type":"integer","minimum":1},"execution_mode":{"enum":["live-chain","test-gate"]},"order_key":{"$ref":"#/$defs/sha256"}}}},
    "capture_at_run": {
      "type":"object","additionalProperties":false,
      "required":["started_at","finished_at","genesis_hashes","fixture_anchor_blocks","start_blocks","end_blocks"],
      "properties":{"started_at":{"const":null},"finished_at":{"const":null},"genesis_hashes":{"const":null},"fixture_anchor_blocks":{"const":null},"start_blocks":{"const":null},"end_blocks":{"const":null}}
    }
  }
}
