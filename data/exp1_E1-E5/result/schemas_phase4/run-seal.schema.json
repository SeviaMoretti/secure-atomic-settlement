    "schema_id":{"const":"assetxchain-exp2-phase4-run-seal"},"schema_version":{"const":1},"tooling_version":{"const":"phase4-formal-tooling-v1"},"run_id":{"$ref":"#/$defs/nonempty"},"status":{"enum":["completed","invalid"]},"started_at":{"$ref":"#/$defs/nonempty"},"finished_at":{"$ref":"#/$defs/nonempty"},"timezone":{"const":"Asia/Shanghai"},"preflight_sha256":{"$ref":"#/$defs/sha256"},
