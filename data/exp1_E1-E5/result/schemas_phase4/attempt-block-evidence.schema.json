{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assetxchain-exp2-phase4-attempt-block-evidence-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "transaction_hash",
    "parent_block_hash",
    "included_block_hash",
    "parent_block_number",
    "included_block_number",
    "terminal_status",
    "extrinsic_index",
    "transaction_event_indexes",
    "complete_block_event_count",
    "events"
  ],
  "$defs": {
    "hex32": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_index", "section", "method", "phase", "data"],
      "properties": {
        "event_index": {"type": "integer", "minimum": 0},
        "section": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "phase": {"type": "string", "minLength": 1},
        "data": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "properties": {
    "schema_id": {"const": "assetxchain-exp2-phase4-attempt-block-evidence"},
    "schema_version": {"const": 1},
    "transaction_hash": {"$ref": "#/$defs/hex32"},
    "parent_block_hash": {"$ref": "#/$defs/hex32"},
    "included_block_hash": {"$ref": "#/$defs/hex32"},
    "parent_block_number": {"type": "integer", "minimum": 0},
    "included_block_number": {"type": "integer", "minimum": 1},
    "terminal_status": {"enum": ["in-block", "finalized"]},
    "extrinsic_index": {"type": "integer", "minimum": 0},
    "transaction_event_indexes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "complete_block_event_count": {"type": "integer", "minimum": 1},
    "events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event"}}
  }
}
