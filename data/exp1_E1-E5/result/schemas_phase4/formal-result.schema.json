{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assetxchain-exp2-phase4-formal-result-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id","schema_version","contract_version","run","request","outcome","snapshots","events","settlement","correctness","cost","architecture_cost","claim_boundary"],
  "$defs": {
    "nonnegative":{"type":"integer","minimum":0},
    "metric":{"type":"object","additionalProperties":false,"required":["availability","value","unit"],"properties":{"availability":{"enum":["measured","not-collected","N/A"]},"value":{"type":["string","null"],"pattern":"^[0-9]+(\\.[0-9]+)?$"},"unit":{"type":"string","minLength":1}}},
    "nullable_hex32":{"type":["string","null"],"pattern":"^0x[0-9a-f]{64}$"},
    "environmental_adjustment":{"type":"object","additionalProperties":false,"required":["role","account","reason","amount","block_number","event_index","event_phase"],"properties":{"role":{"enum":["OWNER","RIGHT_SELLER","BUYER_1","BUYER_2","MARKET_OK","MARKET_DENIED","RELAYER"]},"account":{"type":"string","pattern":"^0x[0-9a-f]{64}$"},"reason":{"const":"block-author-reward"},"amount":{"type":"string","pattern":"^[1-9][0-9]*$"},"block_number":{"type":"integer","minimum":0},"event_index":{"type":"integer","minimum":0},"event_phase":{"type":"string","minLength":1}}}
  },
  "properties": {
    "schema_id":{"const":"assetxchain-exp2-phase4-formal-result"},"schema_version":{"const":1},"contract_version":{"const":"phase3-adapter-contract-v1"},
    "run":{"type":"object","additionalProperties":false,"required":["run_id","timestamp","timezone","baseline_id","baseline_name","baseline_profile_version","settlement_protocol_version","validity_level","implementation_commit","git_dirty","config_path","workload_id","seed","repetition"],"properties":{"run_id":{"type":"string","minLength":1},"timestamp":{"type":"string","minLength":1},"timezone":{"const":"Asia/Shanghai"},"baseline_id":{"enum":["B1","B2","G3"]},"baseline_name":{"enum":["Contract-only","Runtime-only","AssetXChain-CRS"]},"baseline_profile_version":{"const":"1"},"settlement_protocol_version":{"const":1},"validity_level":{"const":"provisional-candidate"},"implementation_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},"git_dirty":{"const":false},"config_path":{"type":"string","minLength":1},"workload_id":{"type":"string","minLength":1},"seed":{"type":"integer","minimum":0},"repetition":{"type":"integer","minimum":1}}},
    "request":{"type":"object","additionalProperties":false,"required":["scenario_id","attempt_id","phase","operation","expected_outcome","expected_error_code"],"properties":{"scenario_id":{"type":"string","minLength":1},"attempt_id":{"type":"string","minLength":1},"phase":{"enum":["create_order","fund_order","settle","cancel_open","expire_open","refund_funded"]},"operation":{"enum":["TransferMeta","IssueRight","TransferRight"]},"expected_outcome":{"enum":["accept","reject","winner-or-loser"]},"expected_error_code":{"type":["string","null"]}}},
    "outcome":{"type":"object","additionalProperties":false,"required":["dispatch_success","protocol_outcome","common_error_code","native_error","included_block","completion_block","completion_blocks","submission_sequence","extrinsic_index","event_index","dispatch_fee_payer_role","dispatch_fee_amount","environmental_balance_adjustments"],"properties":{"dispatch_success":{"type":"boolean"},"protocol_outcome":{"enum":["accepted","rejected","timeout"]},"common_error_code":{"type":["string","null"]},"native_error":{"type":["string","null"]},"included_block":{"type":["integer","null"],"minimum":0},"completion_block":{"type":["integer","null"],"minimum":0},"completion_blocks":{"type":["integer","null"],"minimum":0},"submission_sequence":{"type":"integer","minimum":1},"extrinsic_index":{"type":["integer","null"],"minimum":0},"event_index":{"type":["integer","null"],"minimum":0},"dispatch_fee_payer_role":{"type":["string","null"]},"dispatch_fee_amount":{"type":"string","pattern":"^[0-9]+$"},"environmental_balance_adjustments":{"type":"array","items":{"$ref":"#/$defs/environmental_adjustment"}}}},
    "snapshots":{"type":"object","additionalProperties":false,"required":["pre","post"],"properties":{"pre":{"type":"object"},"post":{"type":"object"}}},
    "events":{"type":"object","additionalProperties":false,"required":["event_names","success_event_count","post_state_commitment"],"properties":{"event_names":{"type":"array","items":{"type":"string"}},"success_event_count":{"$ref":"#/$defs/nonnegative"},"post_state_commitment":{"$ref":"#/$defs/nullable_hex32"}}},
    "settlement":{"type":"object","additionalProperties":false,"required":["settlement_id","settlement_record_count","refund_recipient","refund_amount","record"],"properties":{"settlement_id":{"$ref":"#/$defs/nullable_hex32"},"settlement_record_count":{"$ref":"#/$defs/nonnegative"},"refund_recipient":{"$ref":"#/$defs/nullable_hex32"},"refund_amount":{"type":["string","null"],"pattern":"^[0-9]+$"},"record":{"type":["object","null"]}}},
    "correctness":{"type":"object","additionalProperties":false,"required":["expected_outcome_match","invariant_violation_count","false_accept_count","false_reject_count","duplicate_settlement_count","dirty_order_count","dirty_authorization_count","event_mismatch_count","timeout_count","critical_state_diff_count","unexpected_balance_delta_count","unexpected_index_delta_count"],"properties":{"expected_outcome_match":{"type":"boolean"},"invariant_violation_count":{"$ref":"#/$defs/nonnegative"},"false_accept_count":{"$ref":"#/$defs/nonnegative"},"false_reject_count":{"$ref":"#/$defs/nonnegative"},"duplicate_settlement_count":{"$ref":"#/$defs/nonnegative"},"dirty_order_count":{"$ref":"#/$defs/nonnegative"},"dirty_authorization_count":{"$ref":"#/$defs/nonnegative"},"event_mismatch_count":{"$ref":"#/$defs/nonnegative"},"timeout_count":{"$ref":"#/$defs/nonnegative"},"critical_state_diff_count":{"$ref":"#/$defs/nonnegative"},"unexpected_balance_delta_count":{"$ref":"#/$defs/nonnegative"},"unexpected_index_delta_count":{"$ref":"#/$defs/nonnegative"}}},
    "cost":{"type":"object"},"architecture_cost":{"type":"object"},"claim_boundary":{"type":"string","minLength":1}
  }
}
