H = lambda byte: "0x" + byte * 64
OWNER = H("1")
BUYER = H("2")
MARKET = H("3")


def metric(availability: str, unit: str):
    return {"availability": availability, "value": None, "unit": unit}


def costs(baseline: str):
    common_units = {
        "latency_ms": "ms", "completion_blocks": "blocks", "partial_fee": "plancks",
        "weight_ref_time": "ref_time", "weight_proof_size": "bytes",
        "storage_writes": "count", "events_count": "count",
        "rpc_response_ms": "ms", "phase_call_count": "count",
    }
    architecture_units = {
        "contract_gas_or_ref_time": "ref_time", "contract_storage_writes": "count",
        "runtime_dispatch_count": "count", "runtime_storage_writes": "count",
        "typed_ce_call_count": "count", "projection_storage_writes": "count",
    }
    applicable = {
        "B1": {"contract_gas_or_ref_time", "contract_storage_writes"},
        "B2": {"runtime_dispatch_count", "runtime_storage_writes"},
        "G3": set(architecture_units),
    }[baseline]
    return (
        {name: metric("not-collected", unit) for name, unit in common_units.items()},
        {name: metric("not-collected" if name in applicable else "N/A", unit) for name, unit in architecture_units.items()},
    )


def snapshot(baseline: str, operation: str, phase: str, attempt_sequence: int = 1):
    order_exists = phase != "create_order"
    order_state = None
    payment_state = "Unfunded"
    escrow = "0"
    if phase in {"fund_order", "settle", "refund_funded"}:
        order_state = "Open" if phase == "fund_order" else "Funded"
    if phase in {"settle", "refund_funded"}:
        payment_state = "Escrowed"
        escrow = "100"
    projection = (
        {"availability": "N/A", "authoritative": False, "order_state": None, "settlement_record_count": None}
        if baseline in {"B1", "B2"}
        else {"availability": "observed", "authoritative": False, "order_state": order_state, "settlement_record_count": 0}
    )
    return {
        "schema_id": "assetxchain-exp2-normalized-snapshot",
        "schema_version": 1,
        "contract_version": "phase3-adapter-contract-v1",
        "baseline_id": baseline,
        "authority_source": "contract" if baseline == "B1" else "runtime",
        "observed_at": {"block_number": 10 + attempt_sequence, "attempt_sequence": attempt_sequence},
        "meta": {"exists": True, "asset_id": H("a"), "owner": OWNER, "status": "Tradable", "state_version": 1, "owner_index_matches": True, "active_right_count": 0, "active_order_id": H("d") if order_exists else None},
        "right": {"exists": operation != "TransferMeta", "right_id": H("b") if operation != "TransferMeta" else None, "holder": OWNER if operation != "TransferMeta" else None, "status": "Active" if operation != "TransferMeta" else None, "state_version": 1 if operation != "TransferMeta" else None, "parent_asset_id": H("a") if operation != "TransferMeta" else None, "valid": True if operation != "TransferMeta" else None, "remaining_uses": 1 if operation != "TransferMeta" else None, "holder_index_matches": True if operation != "TransferMeta" else None, "parent_index_matches": True if operation != "TransferMeta" else None, "active_order_id": H("d") if order_exists and operation == "TransferRight" else None},
        "order": {"exists": order_exists, "order_id": H("d") if order_exists else None, "operation": operation if order_exists else None, "state": order_state, "seller": OWNER if order_exists else None, "buyer": BUYER if order_exists and phase != "fund_order" else None, "expiry": 30 if order_exists else None, "grace_deadline": 40 if order_exists else None, "active_capacity_occupied": order_exists, "funded_capacity_occupied": order_state == "Funded"},
        "authorization": {"exists": True, "authorization_id": H("e"), "status": "Active", "policy_hash": H("f"), "issued_count": 0, "reserved_count": 1 if order_state == "Funded" and operation == "IssueRight" else 0, "issued_use_units": 0, "reserved_use_units": 0, "consumed": False, "consumed_order_id": None},
        "payment": {"state": payment_state, "escrow_amount": escrow, "buyer_balance": "1000", "seller_balance": "1000", "royalty_balance": "0", "market_balance": "1000", "safety_balance": "0"},
        "evidence": {"settlement_record_count": 0, "settlement_id": None, "record_fields_hash": None, "pre_state_commitment": None},
        "market": {"exists": True, "market_id": MARKET, "status": "Active", "capabilities": ["TransferMeta", "IssueRight", "TransferRight"], "active_orders": 1 if order_exists else 0, "funded_orders": 1 if order_state == "Funded" else 0, "active_exposure_value": escrow},
        "identity": {"settlement_protocol_version": 1, "settlement_domain_id": "axc/p2/shared", "order_commitment_hash": H("c") if order_exists else None, "seller_nonce": 0, "buyer_nonce": 0, "authorization_nonce": 0, "object_state_version": 1},
        "state_commitment": H("9"),
        "projection": projection,
    }


def rejected_result(preflight, scenario, expected, repetition, sequence):
    baseline = preflight["baseline"]["baseline_id"]
    pre = snapshot(baseline, scenario["operation"], expected["phase"], sequence)
    post = copy.deepcopy(pre)
    pre["observed_at"] = {"block_number": 19, "attempt_sequence": sequence}
    post["observed_at"] = {"block_number": 20, "attempt_sequence": sequence}
    common, architecture = costs(baseline)
    outcome = {
        "dispatch_success": False, "protocol_outcome": "rejected",
        "common_error_code": expected["expected_error_code"], "native_error": expected["expected_error_code"],
        "included_block": 20, "completion_block": 20, "completion_blocks": 0,
        "submission_sequence": sequence, "extrinsic_index": 0,
        "event_index": 0, "dispatch_fee_payer_role": "RELAYER", "dispatch_fee_amount": "0",
        "environmental_balance_adjustments": [],
    }
    events = {"event_names": [], "success_event_count": 0, "post_state_commitment": None}
    result = {
        "schema_id": "assetxchain-exp2-phase4-formal-result", "schema_version": 1,
        "contract_version": "phase3-adapter-contract-v1",
        "run": {"run_id": preflight["run_id"], "timestamp": preflight["created_at"], "timezone": "Asia/Shanghai", "baseline_id": baseline, "baseline_name": preflight["baseline"]["baseline_name"], "baseline_profile_version": "1", "settlement_protocol_version": 1, "validity_level": "provisional-candidate", "implementation_commit": preflight["baseline"]["head"], "git_dirty": False, "config_path": preflight["inputs"]["workload"]["path"], "workload_id": preflight["inputs"]["workload_id"], "seed": preflight["inputs"]["seed"], "repetition": repetition},
        "request": {"scenario_id": scenario["scenario_id"], "attempt_id": expected["attempt_id"], "phase": expected["phase"], "operation": scenario["operation"], "expected_outcome": expected["expected_outcome"], "expected_error_code": expected["expected_error_code"]},
        "outcome": outcome, "snapshots": {"pre": pre, "post": post}, "events": events,
        "settlement": {"settlement_id": None, "settlement_record_count": 0, "refund_recipient": None, "refund_amount": None, "record": None},
        "correctness": {"expected_outcome_match": True, "invariant_violation_count": 0, "false_accept_count": 0, "false_reject_count": 0, "duplicate_settlement_count": 0, "dirty_order_count": 0, "dirty_authorization_count": 0, "event_mismatch_count": 0, "timeout_count": 0, "critical_state_diff_count": 0, "unexpected_balance_delta_count": 0, "unexpected_index_delta_count": 0},
        "cost": common, "architecture_cost": architecture, "claim_boundary": "formal-correctness-only",
    }
    invocation = {"run_id": preflight["run_id"], "baseline_id": baseline, "scenario_id": scenario["scenario_id"], "attempt_id": expected["attempt_id"], "repetition": repetition, "phase": expected["phase"], "operation": scenario["operation"], "actor_role": "RELAYER"}
    return result, invocation


def write_attempt(root: Path, result, invocation):
    write_json_exclusive(root / "result.json", result)
    write_json_exclusive(root / "invocation.json", invocation)
    write_json_exclusive(root / "dispatch.json", result["outcome"])
    write_json_exclusive(root / "pre-state.json", result["snapshots"]["pre"])
    write_json_exclusive(root / "post-state.json", result["snapshots"]["post"])
    write_json_exclusive(root / "events.json", result["events"])
    write_json_exclusive(root / "block-events.json", {
        "schema_id": "assetxchain-exp2-phase4-attempt-block-evidence",
        "schema_version": 1,
        "transaction_hash": H("1"),
        "parent_block_hash": H("2"),
        "included_block_hash": H("3"),
        "parent_block_number": 19,
        "included_block_number": 20,
        "terminal_status": "in-block",
        "extrinsic_index": 0,
        "transaction_event_indexes": [0],
        "complete_block_event_count": 1,
        "events": [{
            "event_index": 0,
            "section": "system",
            "method": "ExtrinsicFailed",
            "phase": "ApplyExtrinsic(0)",
            "data": [],
        }],
    })


class Phase4ToolingTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.fixed = datetime(2026, 7, 29, 16, 0, 0, tzinfo=ZoneInfo("Asia/Shanghai"))
        cls.executor = [sys.executable, str(PHASE4_DIR / "tests/fake_executor.py")]
        cls.node = Path("/home/gz785/.local/node-v24.15.0-linux-x64/bin/node")
        cls.e0_executor = PHASE4_DIR / "formal_e0_executor.js"
        cls.e0_dependencies = [
            cls.e0_executor,
            EXP_ROOT / "scripts/scenarios/s314_live_common.js",
            EXP_ROOT / "scripts/scenarios/s314_b1_live_smoke.js",
            EXP_ROOT / "scripts/scenarios/s314_b2_live_smoke.js",
            EXP_ROOT / "scripts/scenarios/s314_g3_live_smoke.js",
            PHASE4_DIR / "node/package.json",
            PHASE4_DIR / "node/package-lock.json",
            EXP_ROOT / "configs/phase4/formal-toolchain-v1.json",
        ]
        cls.live_e0_executor = [str(cls.node), str(cls.e0_executor)]
        for dependency in cls.e0_dependencies:
            cls.live_e0_executor.extend(["--dependency", str(dependency)])

    def test_live_e0_executor_argv_and_dependency_capture(self):
        source = self.e0_executor.read_text(encoding="utf-8")
        self.assertNotIn("fake_executor", source)
        self.assertNotIn("synthetic", source.lower())
        self.assertIn("decoded.event.identifier.split('::').pop()", source)
        script = f"""
const executor = require({json.dumps(str(self.e0_executor))});
const base = ['--preflight','p','--scenario-id','LEG-META-01','--repetition','1',
  '--execution-mode','live-chain','--output-root','o','--rpc','ws://127.0.0.1:9944',
  '--dependency','d'];
const parsed = executor.parseArgs(base);
const parsedFive = executor.parseArgs(base.map((item, index) => index === 5 ? '5' : item));
let unknown = false;
let badRepetition = false;
let fractionalRepetition = false;
try {{ executor.parseArgs([...base, '--unknown', 'x']); }} catch (_error) {{ unknown = true; }}
try {{ executor.parseArgs(base.map((item, index) => index === 5 ? '0' : item)); }} catch (_error) {{ badRepetition = true; }}
try {{ executor.parseArgs(base.map((item, index) => index === 5 ? '1.5' : item)); }} catch (_error) {{ fractionalRepetition = true; }}
(async () => {{
  const balance = await executor.freeBalance({{
    query: {{ system: {{ account: async () => ({{ data: {{ free: {{ toString: () => '123456' }} }} }}) }} }},
  }}, {{ address: 'test' }});
  let block = 13;
  const anchor = await executor.deterministicFixtureAnchor({{
    rpc: {{ chain: {{ getHeader: async () => ({{ number: {{ toNumber: () => ++block }} }}) }} }},
  }}, 16, 0, 1000);
  let overrunRejected = false;
  try {{
    await executor.deterministicFixtureAnchor({{
      rpc: {{ chain: {{ getHeader: async () => ({{ number: {{ toNumber: () => 17 }} }}) }} }},
    }}, 16, 0, 1000);
  }} catch (_error) {{ overrunRejected = true; }}
  console.log(JSON.stringify({{
    repetition: parsed.repetition, repetitionFive: parsedFive.repetition, unknown, badRepetition,
    fractionalRepetition, balance, anchor, overrunRejected,
  }}));
}})().catch((error) => {{ console.error(error); process.exit(1); }});
"""
        completed = subprocess.run(
            [str(self.node), "-e", script], text=True, capture_output=True, check=True,
            timeout=30, env={key: value for key, value in os.environ.items() if key != "POLKADOT_DRIVER_ROOT"},
        )
        self.assertEqual(json.loads(completed.stdout.strip()), {
            "repetition": 1,
            "repetitionFive": 5,
            "unknown": True,
            "badRepetition": True,
            "fractionalRepetition": True,
            "balance": "123456",
            "anchor": 16,
            "overrunRejected": True,
        })
        preflight = build_preflight(
            exp_root=EXP_ROOT, baseline_id="B1", family="E0",
            executor_command=self.live_e0_executor, created_at=self.fixed,
        )
        captured = {Path(item["path"]).resolve() for item in preflight["execution"]["executor_artifacts"]}
        self.assertTrue({self.node.resolve(), *(item.resolve() for item in self.e0_dependencies)}.issubset(captured))
        environment, toolchain = _formal_environment(preflight)
        self.assertEqual(environment["RUSTUP_TOOLCHAIN"], "1.85.0")
        self.assertEqual(toolchain["versions"]["rustc"], "rustc 1.85.0 (4d91de4e4 2025-02-17)")
        self.assertEqual(toolchain["versions"]["cargo"], "cargo 1.85.0 (d73d2caf9 2024-12-31)")
        self.assertEqual(toolchain["versions"]["cargo_contract"], "cargo-contract 4.1.1-unknown-x86_64-unknown-linux-gnu")
        self.assertIn(
            "cargo contract build --release --manifest-path contracts/market_pure_contract/Cargo.toml",
            preflight["execution"]["build_commands"],
        )
        g3_preflight = build_preflight(
            exp_root=EXP_ROOT, baseline_id="G3", family="E0",
            executor_command=self.live_e0_executor, created_at=self.fixed,
        )
        self.assertIn(
            "cargo contract build --release --manifest-path contracts/market_orderbook/Cargo.toml",
            g3_preflight["execution"]["build_commands"],
        )
        self.assertIn(
            "/home/gz785/code/assetxchain-g3-v2/target/ink/market_orderbook/market_orderbook.wasm",
            g3_preflight["execution"]["artifact_paths"],
        )

    def test_b1_decodes_ordinary_and_manual_payable_reverts(self):
        b1_script = EXP_ROOT / "scripts/scenarios/s314_b1_live_smoke.js"
        metadata = Path(
            "/home/gz785/code/assetxchain-b1/contracts/market_pure_contract/target/ink/market_pure_contract.json"
        )
        script = f"""
process.env.POLKADOT_DRIVER_ROOT = {json.dumps(str(PHASE4_DIR / 'node'))};
const fs = require('fs');
const b1 = require({json.dumps(str(b1_script))});
const {{ TypeRegistry }} = require({json.dumps(str(PHASE4_DIR / 'node/node_modules/@polkadot/types/create'))});
const {{ Abi }} = require({json.dumps(str(PHASE4_DIR / 'node/node_modules/@polkadot/api-contract'))});
const abi = new Abi(
  JSON.parse(fs.readFileSync({json.dumps(str(metadata))}, 'utf8')),
  new TypeRegistry().getChainProperties()
);
const message = abi.findMessage('fundOrder');
const decode = (hex, reverted) => b1.decodeMessageOutput(
  {{ abi }}, message, Uint8Array.from(Buffer.from(hex.slice(2), 'hex')), reverted
).toJSON();
let innerWithoutRevertRejected = false;
let unknownRejected = false;
try {{ decode('0x0137', false); }} catch (_error) {{ innerWithoutRevertRejected = true; }}
try {{ decode('0x01ff', true); }} catch (_error) {{ unknownRejected = true; }}
console.log(JSON.stringify({{
  ordinary: decode('0x000115', true),
  payable: decode('0x0137', true),
  innerWithoutRevertRejected,
  unknownRejected,
}}));
"""
        completed = subprocess.run(
            [str(self.node), "-e", script], text=True, capture_output=True, check=True,
            timeout=30, env={key: value for key, value in os.environ.items() if key != "POLKADOT_DRIVER_ROOT"},
        )
        self.assertEqual(json.loads(completed.stdout.strip()), {
            "ordinary": {"ok": {"err": "UnsupportedProtocolVersion"}},
            "payable": {"err": "InsufficientBalance"},
            "innerWithoutRevertRejected": True,
            "unknownRejected": True,
        })

    def test_send_tx_captures_one_terminal_block_event_snapshot(self):
        common_script = EXP_ROOT / "scripts/scenarios/s314_live_common.js"
        g3_source = (EXP_ROOT / "scripts/scenarios/s314_g3_live_smoke.js").read_text(encoding="utf-8")
        self.assertNotIn("async function sendTx", g3_source)
        self.assertIn("  sendTx,", g3_source)
        script = f"""
process.env.POLKADOT_DRIVER_ROOT = {json.dumps(str(PHASE4_DIR / 'node'))};
const common = require({json.dumps(str(common_script))});
let callback;
let unsubscribed = 0;
let eventQueries = 0;
const status = {{
  isInBlock: true, isFinalized: false,
  asInBlock: {{ toHex: () => '0x' + '11'.repeat(32) }},
}};
const tx = {{
  hash: {{ toHex: () => '0x' + '22'.repeat(32) }},
  paymentInfo: async () => ({{ partialFee: {{ toString: () => '9' }}, weight: {{ toJSON: () => ({{ refTime: '1' }}) }} }}),
  signAndSend: async (_signer, handler) => {{ callback = handler; return () => {{ unsubscribed += 1; }}; }},
}};
const reward = {{
  event: {{ section: 'rewards', method: 'RewardPaid', data: [
    {{ toString: () => 'owner' }}, {{ toString: () => '5000' }},
  ] }},
  phase: {{ toString: () => 'Finalization' }},
}};
const api = {{
  rpc: {{ chain: {{ getHeader: async () => ({{
    number: {{ toNumber: () => 19 }}, parentHash: {{ toHex: () => '0x' + '10'.repeat(32) }},
  }}) }} }},
  query: {{ system: {{ events: {{ at: async () => {{ eventQueries += 1; return [reward]; }} }} }} }},
}};
(async () => {{
  const pending = common.sendTx(api, 'test', tx, {{ address: 'actor' }});
  await Promise.resolve();
  const result = {{ status, events: [] }};
  callback(result);
  callback(result);
  const captured = await pending;
  await Promise.resolve();
  console.log(JSON.stringify({{
    blockNumber: captured.blockNumber,
    credits: captured.environmentalBalanceCredits,
    eventQueries,
    unsubscribed,
  }}));
}})().catch((error) => {{ console.error(error); process.exit(1); }});
"""
        completed = subprocess.run(
            [str(self.node), "-e", script], text=True, capture_output=True, check=True,
            timeout=30, env={key: value for key, value in os.environ.items() if key != "POLKADOT_DRIVER_ROOT"},
        )
        value = json.loads(completed.stdout.strip())
        self.assertEqual(value["blockNumber"], 19)
        self.assertEqual(value["eventQueries"], 1)
        self.assertEqual(value["unsubscribed"], 1)
        self.assertEqual(value["credits"], [{
            "account": "owner", "amount": "5000", "reason": "block-author-reward",
            "blockNumber": 19, "eventIndex": 0, "phase": "Finalization",
        }])

    def test_live_executor_enforces_e0_e2_scope_and_lifecycle_contracts(self):
        script = f"""
const executor = require({json.dumps(str(self.e0_executor))});
const catalog = require({json.dumps(str(EXP_ROOT / 'configs/phase4/formal-scenarios-v1.json'))});
const args = {{ scenario_id: 'LEG-META-01', repetition: 2 }};
const base = {{
  validity_level: 'provisional-candidate',
  inputs: {{ repetitions: 2, selected_scenario_ids: executor.FAMILY_SCENARIOS.E0 }},
  experiment_family: 'E0',
}};
const e0 = executor.validateExecutionContract(args, base, catalog);
const e1Preflight = {{
  ...base, experiment_family: 'E1',
  inputs: {{ repetitions: 5, selected_scenario_ids: executor.FAMILY_SCENARIOS.E1 }},
}};
const lifecycle = {{}};
for (const scenarioId of ['LEG-CANCEL-01', 'LEG-EXPIRE-01', 'LEG-REFUND-01']) {{
  lifecycle[scenarioId] = executor.validateExecutionContract(
    {{ scenario_id: scenarioId, repetition: 5 }}, e1Preflight, catalog
  ).attempts[0].phase;
}}
const e2Preflight = {{
  ...base, experiment_family: 'E2',
  inputs: {{ repetitions: 5, selected_scenario_ids: executor.FAMILY_SCENARIOS.E2 }},
}};
const e2 = executor.validateExecutionContract(
  {{ scenario_id: 'NEG-PROTO-01', repetition: 5 }}, e2Preflight, catalog
);
let incompleteE2Rejected = false;
try {{
  executor.validateExecutionContract(
    {{ scenario_id: 'NEG-PROTO-01', repetition: 1 }},
    {{ ...e2Preflight, inputs: {{ repetitions: 5, selected_scenario_ids: ['NEG-PROTO-01'] }} }},
    catalog
  );
}} catch (_error) {{ incompleteE2Rejected = true; }}
let incompleteE1Rejected = false;
try {{
  executor.validateExecutionContract(
    {{ scenario_id: 'LEG-META-01', repetition: 1 }},
    {{ ...e1Preflight, inputs: {{ repetitions: 5, selected_scenario_ids: executor.FAMILY_SCENARIOS.E0 }} }},
    catalog
  );
}} catch (_error) {{ incompleteE1Rejected = true; }}
console.log(JSON.stringify({{
  e0: e0.scenario_id, e2: e2.scenario_id, lifecycle, incompleteE2Rejected,
  incompleteE1Rejected, e0Count: executor.FAMILY_SCENARIOS.E0.length,
  e1Count: executor.FAMILY_SCENARIOS.E1.length,
  e2Count: executor.FAMILY_SCENARIOS.E2.length,
}}));
"""
        completed = subprocess.run(
            [str(self.node), "-e", script], text=True, capture_output=True, check=True, timeout=30,
            env={key: value for key, value in os.environ.items() if key != "POLKADOT_DRIVER_ROOT"},
        )
        self.assertEqual(json.loads(completed.stdout.strip()), {
            "e0": "LEG-META-01",
            "e2": "NEG-PROTO-01",
            "lifecycle": {
                "LEG-CANCEL-01": "cancel_open",
                "LEG-EXPIRE-01": "expire_open",
                "LEG-REFUND-01": "refund_funded",
            },
            "incompleteE2Rejected": True,
            "incompleteE1Rejected": True,
            "e0Count": 3,
            "e1Count": 6,
            "e2Count": 24,
        })

    def test_missing_resale_authorization_uses_a_registered_witness_market(self):
        source = self.e0_executor.read_text(encoding="utf-8")
        self.assertEqual(source.count("authorizationWitnessMarketId || marketId"), 3)
        self.assertIn("registerG3AuthorizationWitnessMarket", source)
        self.assertIn("register_authorization_witness_market", source)
        self.assertNotIn("authorizationId: b1.fixedHash(0xed)", source)
        self.assertNotIn("authorizationId: b2.fixedHash(0xed)", source)
        self.assertNotIn("e2-missing-authorization", source)
        self.assertNotIn("e2-denied-market", source)

    def test_live_executor_rejection_mapping_priority_and_fee_normalization(self):
        script = f"""
const executor = require({json.dumps(str(self.e0_executor))});
let unmappedRejected = false;
try {{ executor.mappedNativeError('B1', 'UnknownNativeError'); }}
catch (_error) {{ unmappedRejected = true; }}
let g3PriorityRejected = false;
try {{
  executor.g3Rejection({{ decoded: {{ error: 'ChainExtension', code: 8, name: 'InvalidSignature' }} }});
}} catch (_error) {{ g3PriorityRejected = true; }}
const g3 = executor.g3Rejection({{
  decoded: {{ error: 'ChainExtension', code: 8, name: 'AuthorizationMissing' }},
}});

const pre = {{
  schema_id: 'snapshot', observed_at: {{ block_number: 10, attempt_sequence: 1 }},
  payment: {{
    buyer_balance: '100', seller_balance: '100', royalty_balance: '0',
    market_balance: '100', safety_balance: '0',
  }},
  evidence: {{ settlement_record_count: 0 }},
}};
const post = JSON.parse(JSON.stringify(pre));
post.observed_at = {{ block_number: 11, attempt_sequence: 1 }};
post.payment.buyer_balance = '99';
post.payment.seller_balance = '105';
const reward = {{
  account: '0x' + '11'.repeat(32), amount: '5', reason: 'block-author-reward',
  blockNumber: 11, eventIndex: 7, phase: 'Finalization',
}};
const context = {{
  baseline: 'B2', repetition: 1, submissionSequence: 1,
  snapshotSellerRole: 'OWNER', snapshotBuyerRole: 'BUYER_1',
  accountsByRole: {{
    OWNER: {{ address: '0x' + '11'.repeat(32) }},
    BUYER_1: {{ address: '0x' + '22'.repeat(32) }},
  }},
  operation: 'TransferMeta', scenario: {{ scenario_id: 'NEG-AUTH-01' }},
  preflight: {{
    run_id: 'test', created_at: '2026-07-29T16:00:00+08:00', baseline: {{ head: 'abc' }},
    inputs: {{ workload: {{ path: 'formal.json' }}, workload_id: 'formal-correctness-v1', seed: 20260729 }},
  }},
}};
const expected = {{
  attempt_id: 'reject', phase: 'create_order', expected_outcome: 'reject',
  expected_error_code: 'AuthorizationMissing',
}};
const txEvidence = {{
  txHash: '0x' + '01'.repeat(32), parentBlockHash: '0x' + '02'.repeat(32),
  blockHash: '0x' + '03'.repeat(32), terminalStatus: 'in-block',
  events: [{{ phase: {{ isApplyExtrinsic: true, asApplyExtrinsic: {{ toNumber: () => 0 }} }} }}],
  eventIndexes: [0],
  blockEventRows: [{{
    eventIndex: 0, section: 'system', method: 'ExtrinsicFailed',
    phase: 'ApplyExtrinsic(0)', data: [],
  }}],
}};
const result = executor.makeRejectedResult(
  context, expected, {{
    ...txEvidence, blockNumber: 11, partialFee: '1', environmentalBalanceCredits: [reward],
  }},
  pre, post, {{ names: [], eventIndex: 0, postStateCommitment: null }}, 'BUYER_1',
  {{ nativeError: 'AuthorizationMissing', commonError: 'AuthorizationMissing' }}
);
const resalePre = JSON.parse(JSON.stringify(pre));
const resalePost = JSON.parse(JSON.stringify(pre));
resalePost.observed_at = {{ block_number: 11, attempt_sequence: 1 }};
const resaleResult = executor.makeRejectedResult(
  {{
    ...context, operation: 'TransferRight', snapshotSellerRole: 'RIGHT_SELLER',
    snapshotBuyerRole: 'BUYER_2',
  }},
  expected, {{
    ...txEvidence, blockNumber: 11, partialFee: '0', environmentalBalanceCredits: [reward],
  }},
  resalePre, resalePost, {{ names: [], eventIndex: 0, postStateCommitment: null }}, 'RELAYER',
  {{ nativeError: 'AuthorizationMissing', commonError: 'AuthorizationMissing' }}
);
let wrongPriorityRejected = false;
try {{
  executor.makeRejectedResult(
    context, expected, {{
      ...txEvidence, blockNumber: 11, partialFee: '1', environmentalBalanceCredits: [reward],
    }},
    pre, post, {{ names: [], eventIndex: 0, postStateCommitment: null }}, 'BUYER_1',
    {{ nativeError: 'InvalidSignature', commonError: 'InvalidSignature' }}
  );
}} catch (_error) {{ wrongPriorityRejected = true; }}
console.log(JSON.stringify({{
  unmappedRejected, g3PriorityRejected, wrongPriorityRejected,
  g3Common: g3.commonError,
  clean: result.snapshots.pre.state_commitment === result.snapshots.post.state_commitment,
  feePayer: result.outcome.dispatch_fee_payer_role,
  fee: result.outcome.dispatch_fee_amount,
  adjustment: result.outcome.environmental_balance_adjustments[0],
  resaleClean: resaleResult.snapshots.pre.state_commitment === resaleResult.snapshots.post.state_commitment,
}}));
"""
        completed = subprocess.run(
            [str(self.node), "-e", script], text=True, capture_output=True, check=True, timeout=30,
            env={key: value for key, value in os.environ.items() if key != "POLKADOT_DRIVER_ROOT"},
        )
        self.assertEqual(json.loads(completed.stdout.strip()), {
            "unmappedRejected": True,
            "g3PriorityRejected": True,
            "wrongPriorityRejected": True,
            "g3Common": "AuthorizationMissing",
            "clean": True,
            "feePayer": "BUYER_1",
            "fee": "1",
            "adjustment": {
                "role": "OWNER",
                "account": "0x" + "11" * 32,
                "reason": "block-author-reward",
                "amount": "5",
                "block_number": 11,
                "event_index": 7,
                "event_phase": "Finalization",
            },
            "resaleClean": True,
        })

    def test_live_executor_refund_result_uses_authoritative_pre_and_post_state(self):
        script = f"""
const executor = require({json.dumps(str(self.e0_executor))});
const hash = '0x' + '11'.repeat(32);
const pre = {{ payment: {{ escrow_amount: '700' }} }};
const post = {{ order: {{ buyer: hash }}, evidence: {{ settlement_record_count: 0 }} }};
const context = {{
  baseline: 'B2', repetition: 1, submissionSequence: 1, lastRecord: null,
  operation: 'IssueRight', scenario: {{ scenario_id: 'LEG-REFUND-01' }},
  preflight: {{
    experiment_family: 'E1', run_id: 'test', created_at: '2026-07-29T16:00:00+08:00',
    baseline: {{ head: 'abc' }},
    inputs: {{ workload: {{ path: 'configs/workloads/formal_correctness.json' }}, workload_id: 'formal-correctness-v1', seed: 20260729 }},
  }},
}};
const expected = {{ attempt_id: 'refund', phase: 'refund_funded', expected_outcome: 'accept', expected_error_code: null }};
const tx = {{
  txHash: '0x' + '01'.repeat(32), parentBlockHash: '0x' + '02'.repeat(32),
  blockHash: '0x' + '03'.repeat(32), blockNumber: 20, terminalStatus: 'in-block', partialFee: '1',
  events: [{{ phase: {{ isApplyExtrinsic: true, asApplyExtrinsic: {{ toNumber: () => 0 }} }} }}],
  eventIndexes: [0], environmentalBalanceCredits: [],
  blockEventRows: [{{
    eventIndex: 0, section: 'system', method: 'ExtrinsicSuccess',
    phase: 'ApplyExtrinsic(0)', data: [],
  }}],
}};
const result = executor.makeResult(context, expected, tx, pre, post, {{ names: ['OrderRefunded'], eventIndex: 0, postStateCommitment: null }}, 'RELAYER');
console.log(JSON.stringify({{
  recipient: result.settlement.refund_recipient, amount: result.settlement.refund_amount,
  successEvents: result.events.success_event_count, claimBoundary: result.claim_boundary,
}}));
"""
        completed = subprocess.run(
            [str(self.node), "-e", script], text=True, capture_output=True, check=True, timeout=30,
            env={key: value for key, value in os.environ.items() if key != "POLKADOT_DRIVER_ROOT"},
        )
        self.assertEqual(json.loads(completed.stdout.strip()), {
            "recipient": "0x" + "11" * 32,
            "amount": "700",
            "successEvents": 0,
            "claimBoundary": "formal-correctness-only; not-performance-evidence",
        })

    def test_e0_repetition_hash_gate_detects_drift(self):
        preflight = {"experiment_family": "E0", "inputs": {"selected_scenario_ids": ["LEG-META-01"]}}
        shared = "0xc427552f41308fe6e7345a4af448ef3670caba676f1da46e433a1b0aa88e9c13"
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            for repetition in (1, 2):
                write_json_exclusive(
                    root / "attempts/LEG-META-01" / f"r-{repetition:03d}" / "unit-manifest.json",
                    {
                        "genesis_hash": H("a"), "metadata_hash": H("b"),
                        "fixture_state_hash": H("c"), "scenario_result_hash": H("d"),
                        "shared_input_hash": shared,
                    },
                )
            failures = CheckFailure()
            _check_e0_reproducibility(root, preflight, failures)
            self.assertEqual(failures.rows, [])
            second = root / "attempts/LEG-META-01/r-002/unit-manifest.json"
            second.chmod(0o644)
            changed = load_json(second)
            changed["scenario_result_hash"] = H("e")
            second.write_bytes(canonical_json_bytes(changed))
            failures = CheckFailure()
            _check_e0_reproducibility(root, preflight, failures)
            self.assertTrue(any(row["code"] == "reproducibility" for row in failures.rows))

    def test_catalog_exact_scope_and_race_contracts(self):
        catalog = load_catalog()
        self.assertEqual(len(catalog["scenarios"]), 42)
        self.assertEqual(sum(item["execution_mode"] == "live-chain" for item in catalog["scenarios"]), 39)
        self.assertEqual(sum(item["execution_mode"] == "test-gate" for item in catalog["scenarios"]), 3)
        races = [item for item in catalog["scenarios"] if item["category"] == "competition"]
        self.assertEqual(len(races), 4)
        self.assertTrue(all("cardinality" in item for item in races))

    def test_executor_closes_e3_scope_commands_and_test_gate_evidence(self):
        source = self.e0_executor.read_text(encoding="utf-8")
        self.assertIn("configureMetaStatusForExperiment", source)
        self.assertIn("configureRightStatusForExperiment", source)
        self.assertIn("scenario.execution_mode === args.execution_mode", source)
        script = f"""
const executor = require({json.dumps(str(self.e0_executor))});
const output = Buffer.from('rollback-ok', 'utf8');
const context = {{
  baseline: 'B1', repetition: 3,
  scenario: {{ scenario_id: 'CLEAN-ABORT-META-01' }},
  preflight: {{ run_id: 'run-e3', baseline: {{ head: 'commit-e3' }} }},
}};
const evidence = executor.makeTestGateEvidence(
  context,
  executor.testGateCommand('B1', 'CLEAN-ABORT-META-01'),
  0, true, false, output
);
console.log(JSON.stringify({{
  family: executor.FAMILY_SCENARIOS.E3,
  commands: {{
    B1: executor.testGateCommand('B1', 'CLEAN-ABORT-ISSUE-01'),
    B2: executor.testGateCommand('B2', 'CLEAN-ABORT-ISSUE-01'),
    G3: executor.testGateCommand('G3', 'CLEAN-ABORT-ISSUE-01'),
  }},
  evidence,
}}));
"""
        completed = subprocess.run(
            [str(self.node), "-e", script], text=True, capture_output=True,
            check=True, timeout=30,
            env={key: value for key, value in os.environ.items() if key != "POLKADOT_DRIVER_ROOT"},
        )
        value = json.loads(completed.stdout)
        self.assertEqual(value["family"], [
            "CLEAN-LATE-META-01", "CLEAN-LATE-RESALE-01",
            "CLEAN-ABORT-META-01", "CLEAN-ABORT-ISSUE-01",
            "CLEAN-ABORT-RESALE-01",
        ])
        self.assertEqual(value["commands"], {
            "B1": ["cargo", "test", "--manifest-path", "contracts/market_pure_contract/Cargo.toml", "clean_abort_issue_01", "--", "--nocapture"],
            "B2": ["cargo", "test", "-p", "pallet-market-runtime", "s38_clean_abort_issue_01", "--", "--nocapture"],
            "G3": ["cargo", "test", "-p", "pallet-dataassets", "clean_abort_issue_01", "--", "--nocapture"],
        })
        evidence = value["evidence"]
        self.assertEqual(set(evidence), {
            "schema_id", "schema_version", "run_id", "baseline_id", "scenario_id",
            "repetition", "attempt_id", "command", "exit_code", "source_commit",
            "q_all_equal", "production_failpoint_exposed", "test_output_sha256",
        })
        self.assertTrue(evidence["q_all_equal"])
        self.assertFalse(evidence["production_failpoint_exposed"])
        self.assertEqual(
            evidence["test_output_sha256"], hashlib.sha256(b"rollback-ok").hexdigest()
        )

