    def _e2_raw(self, directory: Path):
        preflight = build_preflight(exp_root=EXP_ROOT, baseline_id="B2", family="E2", executor_command=self.executor, created_at=self.fixed)
        raw = directory / "raw"
        log = directory / "log"
        preflight = copy.deepcopy(preflight)
        preflight["paths"] = {"raw": str(raw), "log": str(log), "processed": str(directory / "processed"), "report": str(directory / "report.md")}
        write_json_exclusive(raw / "manifest.preflight.json", preflight)
        scenarios = scenario_map(load_catalog())
        for unit in preflight["planned_execution"]:
            scenario = scenarios[unit["scenario_id"]]
            expected = scenario["attempts"][0]
            result, invocation = rejected_result(preflight, scenario, expected, unit["repetition"], 1)
            attempt = raw / "attempts" / scenario["scenario_id"] / f"r-{unit['repetition']:03d}" / "attempt-001"
            write_attempt(attempt, result, invocation)
        return preflight, raw

    def test_checker_accepts_complete_e2_and_detects_q_all_pollution(self):
        with tempfile.TemporaryDirectory() as directory:
            preflight, raw = self._e2_raw(Path(directory))
            with patch("phase4_checker.validate_preflight"):
                report = check_run(raw)
                self.assertEqual(report["summary"]["status"], "PASS")
                self.assertEqual(report["summary"]["completed_attempts"], 120)
                first = next(raw.glob("attempts/*/r-*/attempt-*/result.json"))
                result = load_json(first)
                result["snapshots"]["post"]["payment"]["seller_balance"] = str(
                    int(result["snapshots"]["post"]["payment"]["seller_balance"]) + 5
                )
                result["outcome"]["environmental_balance_adjustments"] = [{
                    "role": "OWNER",
                    "account": OWNER,
                    "reason": "block-author-reward",
                    "amount": "5",
                    "block_number": result["outcome"]["included_block"],
                    "event_index": 1,
                    "event_phase": "Finalization",
                }]
                first.chmod(0o644)
                first.write_bytes(canonical_json_bytes(result))
                dispatch_path = first.parent / "dispatch.json"
                dispatch_path.chmod(0o644)
                dispatch_path.write_bytes(canonical_json_bytes(result["outcome"]))
                post_path = first.parent / "post-state.json"
                post_path.chmod(0o644)
                post_path.write_bytes(canonical_json_bytes(result["snapshots"]["post"]))
                block_path = first.parent / "block-events.json"
                block = load_json(block_path)
                block["events"].append({
                    "event_index": 1,
                    "section": "rewards",
                    "method": "RewardPaid",
                    "phase": "Finalization",
                    "data": [OWNER, "5"],
                })
                block["complete_block_event_count"] = 2
                block_path.chmod(0o644)
                block_path.write_bytes(canonical_json_bytes(block))
                adjusted = check_run(raw)
                self.assertEqual(adjusted["summary"]["status"], "PASS", adjusted["failures"])
                result["snapshots"]["post"]["meta"]["owner"] = BUYER
                first.write_bytes(canonical_json_bytes(result))
                post_path.write_bytes(canonical_json_bytes(result["snapshots"]["post"]))
                polluted = check_run(raw)
                self.assertEqual(polluted["summary"]["status"], "FAIL")
                self.assertGreater(polluted["summary"]["dirty_state"], 0)

    def test_race_cardinality_detects_second_winner(self):
        scenario = scenario_map(load_catalog())["RACE-BUYER-01"]
        base = {"snapshots": {"post": {"evidence": {"settlement_record_count": 0}}}, "events": {"success_event_count": 0}}
        first = copy.deepcopy(base)
        first["outcome"] = {"protocol_outcome": "accepted", "common_error_code": None}
        second = copy.deepcopy(base)
        second["outcome"] = {"protocol_outcome": "accepted", "common_error_code": None}
        failures = CheckFailure()
        _check_scenario_aggregation(scenario, [first, second], 1, failures)
        self.assertTrue(any(row["code"] == "duplicate" for row in failures.rows))

    def test_issue_settlement_closes_i1_i3_i7_i10(self):
        scenario = scenario_map(load_catalog())["LEG-ISSUE-01"]
        pre = snapshot("B2", "IssueRight", "settle", 1)
        post = copy.deepcopy(pre)
        post["observed_at"] = {"block_number": 12, "attempt_sequence": 1}
        post["state_commitment"] = H("8")
        post["order"]["state"] = "Settled"
        post["order"]["buyer"] = BUYER
        post["payment"]["state"] = "Released"
        post["payment"]["escrow_amount"] = "0"
        post["right"].update({"exists": True, "right_id": H("b"), "holder": BUYER, "status": "Active", "state_version": 1, "parent_asset_id": H("a"), "valid": True, "remaining_uses": 1, "holder_index_matches": True, "parent_index_matches": True})
        post["authorization"]["issued_count"] = 1
        post["authorization"]["reserved_count"] = 0
        post["evidence"] = {"settlement_record_count": 1, "settlement_id": H("7"), "record_fields_hash": H("6"), "pre_state_commitment": pre["state_commitment"]}
        record = {
            "settlement_id": H("7"), "order_id": post["order"]["order_id"], "operation": "IssueRight",
            "asset_id": H("a"), "right_id": H("b"), "authorization_id": post["authorization"]["authorization_id"],
            "market_id": post["market"]["market_id"], "policy_hash": post["authorization"]["policy_hash"],
            "order_commitment_hash": post["identity"]["order_commitment_hash"], "seller": OWNER, "buyer": BUYER,
            "currency": "Native", "gross_price": "100", "seller_amount": "100", "royalty_recipient": None,
            "royalty_amount": "0", "market_fee_recipient": MARKET, "market_fee_amount": "0", "safety_fee_amount": "0",
            "pre_state_version": 1, "post_state_version": 2, "pre_state_commitment": pre["state_commitment"],
            "block_number": 12, "settlement_protocol_version": 1,
        }
        result = {
            "request": {"phase": "settle"}, "snapshots": {"pre": pre, "post": post},
            "settlement": {"settlement_id": H("7"), "record": record},
            "events": {"success_event_count": 1, "event_names": ["SettlementFinalized"], "post_state_commitment": post["state_commitment"]},
        }
        failures = CheckFailure()
        _check_accept(result, scenario, (scenario["scenario_id"], 1, "settle"), failures)
        self.assertEqual(failures.rows, [])
        broken = copy.deepcopy(result)
        broken["snapshots"]["post"]["right"]["holder"] = OWNER
        broken["snapshots"]["post"]["authorization"]["issued_count"] = 0
        failures = CheckFailure()
        _check_accept(broken, scenario, (scenario["scenario_id"], 1, "settle"), failures)
        self.assertTrue(any(row["code"] == "I1" for row in failures.rows))
        self.assertTrue(any(row["code"] == "I10" for row in failures.rows))

    def test_processor_is_deterministic_from_sealed_raw(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            preflight, raw = self._e2_raw(root)
            try:
                with patch("phase4_checker.validate_preflight"):
                    checker = check_run(raw, write_report=True)
                create_seal(
                    preflight=preflight, status="completed", started_at=self.fixed.isoformat(), finished_at=self.fixed.isoformat(),
                    genesis_hashes={}, fixture_anchor_blocks={},
                    attempt_counts={"planned_units": 120, "completed_units": 120, "planned_attempts": 120, "completed_attempts": 120},
                    teardown={"owned_processes_stopped": True, "closed_ports": [9944, 30333, 9615], "residual_listener_count": 0},
                    checker=seal_summary(checker), failure_reason=None,
                )
                with patch("phase4_manifest.validate_preflight"):
                    first = process_run(raw)
                    second = process_run(raw)
                self.assertEqual(first["output_hashes"], second["output_hashes"])
                self.assertTrue((Path(preflight["paths"]["processed"]) / "correctness.csv").is_file())
            finally:
                for path in root.rglob("*"):
                    try:
                        path.chmod(0o755 if path.is_dir() else 0o644)
                    except FileNotFoundError:
                        pass

    def test_artifact_inventory_detects_byte_tampering(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            preflight = build_preflight(exp_root=EXP_ROOT, baseline_id="B2", family="E2", executor_command=self.executor, created_at=self.fixed)
            preflight = copy.deepcopy(preflight)
            raw = root / "raw"
            log = root / "log"
            preflight["paths"] = {"raw": str(raw), "log": str(log), "processed": str(root / "processed"), "report": str(root / "report.md")}
            write_json_exclusive(raw / "manifest.preflight.json", preflight)
            write_json_exclusive(raw / "evidence.json", {"value": 1})
            seal, _ = create_seal(
                preflight=preflight, status="invalid", started_at=self.fixed.isoformat(), finished_at=self.fixed.isoformat(),
                genesis_hashes={}, fixture_anchor_blocks={},
                attempt_counts={"planned_units": 120, "completed_units": 0, "planned_attempts": 120, "completed_attempts": 0},
                teardown={"owned_processes_stopped": True, "closed_ports": [9944, 30333, 9615], "residual_listener_count": 0},
                checker={"status": "FAIL", "expected_outcome_mismatches": 0, "invariant_violations": 0, "false_accepts": 0, "false_rejects": 0, "duplicates": 0, "dirty_state": 0, "event_mismatches": 0, "timeouts": 0},
                failure_reason="tooling-test",
            )
            try:
                with patch("phase4_manifest.validate_preflight"):
                    self.assertEqual(validate_artifacts(raw)["status"], "PASS")
                    raw.chmod(0o755)
                    (raw / "evidence.json").chmod(0o644)
                    (raw / "evidence.json").write_bytes(canonical_json_bytes({"value": 2}))
                    with self.assertRaisesRegex(Phase4ValidationError, "inventory drift"):
                        validate_artifacts(raw)
            finally:
                for path in root.rglob("*"):
                    try:
                        path.chmod(0o755 if path.is_dir() else 0o644)
                    except FileNotFoundError:
                        pass


if __name__ == "__main__":
    unittest.main()
